# ===========================================
# TV Hub Environment Configuration
# ===========================================
# Copy this file to .env.local and update values for your environment
# cp .env.example .env.local
#
# Environments:
# - Development: Use localhost URLs
# - Docker: Use host.docker.internal for backend
# - Production: Use actual domain/HTTPS URLs
# ===========================================

# -------------------------------------------
# Backend API Configuration (Server-side)
# -------------------------------------------
# Base URL for backend API calls from Next.js server routes
# Development: http://localhost:8001
# Docker: http://host.docker.internal:8001
# Staging: https://staging-api.yourdomain.com
# Production: https://api.yourdomain.com
BACKEND_API_URL=http://localhost:8001

# Backend host (IP or hostname) - used for uploads proxy
# Use localhost for local dev, host.docker.internal for Docker, or actual IP
BACKEND_HOST=localhost

# Backend API port
BACKEND_PORT=8001

# -------------------------------------------
# Frontend Application Configuration (Client-side)
# -------------------------------------------
# Product identifier
NEXT_PUBLIC_PRODUCT=tvhub

# Application display name
NEXT_PUBLIC_APP_NAME=StreamHub TV Hub

# Frontend server port (for local development)
NEXT_PUBLIC_PORT=3001

# Backend URL for client-side API calls (if needed)
# Should match BACKEND_API_URL in most cases
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8001

# -------------------------------------------
# Environment-Specific Examples
# -------------------------------------------
# DEVELOPMENT (local):
# BACKEND_API_URL=http://localhost:8001
# BACKEND_HOST=localhost
# NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8001

# DOCKER (containerized):
# BACKEND_API_URL=http://host.docker.internal:8001
# BACKEND_HOST=host.docker.internal
# NEXT_PUBLIC_BACKEND_API_URL=http://host.docker.internal:8001

# PRODUCTION:
# BACKEND_API_URL=https://api.yourdomain.com
# BACKEND_HOST=api.yourdomain.com
# NEXT_PUBLIC_BACKEND_API_URL=https://api.yourdomain.com
