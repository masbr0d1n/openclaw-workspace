# Production Environment Configuration
# Used when NEXT_PUBLIC_ENV=production or NODE_ENV=production

# Backend API runs on production server with HTTPS
BACKEND_API_URL=https://api.yourdomain.com
BACKEND_HOST=api.yourdomain.com
BACKEND_PORT=443

# Frontend Configuration
NEXT_PUBLIC_PRODUCT=tvhub
NEXT_PUBLIC_APP_NAME=StreamHub TV Hub
NEXT_PUBLIC_PORT=3001
NEXT_PUBLIC_BACKEND_API_URL=https://api.yourdomain.com

# Production-specific settings
NEXT_PUBLIC_ENV=production

# Security settings (uncomment and configure as needed)
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
