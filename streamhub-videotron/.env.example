# =============================================================================
# Videotron Environment Configuration - Example
# =============================================================================
# Copy this file to .env.local and update values for your environment
# NEVER commit .env.local to version control - it may contain sensitive data
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Product identifier (used for branding and feature flags)
NEXT_PUBLIC_PRODUCT=videotron

# Application name displayed in UI and browser title
NEXT_PUBLIC_APP_NAME=StreamHub Videotron

# Application port (default: 3002)
NEXT_PUBLIC_PORT=3002

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# These variables define the connection to your backend FastAPI service.
# Use different values for development, staging, and production environments.
#
# BACKEND_API_URL: Used for server-side API calls (not exposed to browser)
# NEXT_PUBLIC_BACKEND_API_URL: Used for client-side API calls (exposed to browser)
#
# IMPORTANT: Both should point to the same backend instance.
# -----------------------------------------------------------------------------

# Development Environment (local backend on same machine)
BACKEND_API_URL=http://localhost:8001
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Backend Host/Port Configuration
# -----------------------------------------------------------------------------
# Used for uploads proxy and direct backend connections.
# These are server-side only (not exposed to browser).
# -----------------------------------------------------------------------------

# Backend hostname or IP address
BACKEND_HOST=localhost

# Backend port number
BACKEND_PORT=8001

# =============================================================================
# Environment-Specific Examples
# =============================================================================
# Uncomment and modify the appropriate section for your environment.
# Do not uncomment multiple sections simultaneously.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Development Environment
# -----------------------------------------------------------------------------
# Use when backend is running in a Docker container on the same host.
# host.docker.internal resolves to the host machine from inside containers.
# -----------------------------------------------------------------------------
# BACKEND_API_URL=http://host.docker.internal:8001
# NEXT_PUBLIC_BACKEND_API_URL=http://host.docker.internal:8001
# BACKEND_HOST=host.docker.internal
# BACKEND_PORT=8001

# -----------------------------------------------------------------------------
# Staging Environment
# -----------------------------------------------------------------------------
# Use for staging/testing environment with remote backend.
# -----------------------------------------------------------------------------
# BACKEND_API_URL=http://staging-backend.example.com:8001
# NEXT_PUBLIC_BACKEND_API_URL=http://staging-backend.example.com:8001
# BACKEND_HOST=staging-backend.example.com
# BACKEND_PORT=8001

# -----------------------------------------------------------------------------
# Production Environment
# -----------------------------------------------------------------------------
# Use for production deployment with HTTPS.
# -----------------------------------------------------------------------------
# BACKEND_API_URL=https://api.videotron.example.com
# NEXT_PUBLIC_BACKEND_API_URL=https://api.videotron.example.com
# BACKEND_HOST=api.videotron.example.com
# BACKEND_PORT=443

# =============================================================================
# Security Notes
# =============================================================================
# - Never commit .env.local to version control
# - Use HTTPS in production environments
# - Rotate credentials regularly
# - Use environment-specific secrets management in production
# - Consider using .env.production, .env.staging for different environments
# =============================================================================
